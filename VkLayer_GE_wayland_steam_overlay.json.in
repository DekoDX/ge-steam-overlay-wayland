{
    "file_format_version": "1.1.1",
    "layer": {
        "name": "@META_LAYER_NAME@",
        "type": "GLOBAL",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Steam overlay Wayland compatibility sandwich",
        "component_layers": [
            "@FRONT_LAYER_NAME@",
            "@STEAM_COMPONENT_LAYER_NAME@",
            "@BACK_LAYER_NAME@"
        ],
        "enable_environment": {
            "WINE_WAYLAND_STEAM_OVERLAY_LAYER": "1"
        },
        "disable_environment": {
            "DISABLE_WINE_WAYLAND_STEAM_OVERLAY_LAYER": "1"
        }
    }
}
