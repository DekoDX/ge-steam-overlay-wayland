{
    "file_format_version": "1.2.1",
    "layer": {
        "name": "@BACK_LAYER_NAME@",
        "type": "INSTANCE",
        "library_path": "@CMAKE_INSTALL_FULL_LIBDIR@/steam-overlay-wayland/libVkLayer_GE_Wayland_SteamOverlay_Back.so",
        "library_arch": "@LAYER_ARCH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Steam overlay Xlib-to-Wayland Vulkan surface translator",
        "instance_extensions": [
            {
                "name": "VK_KHR_xlib_surface",
                "spec_version": "6",
                "entrypoints": [
                    "vkCreateXlibSurfaceKHR",
                    "vkGetPhysicalDeviceXlibPresentationSupportKHR"
                ]
            }
        ]
    }
}
